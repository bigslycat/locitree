{
  "$schema": "https://opencode.ai/config.json",

  "formatter": {
    "prettier": { "disabled": true },
    "biome": { "disabled": true },

    "oxfmt": {
      "extensions": [
        ".js",
        ".cjs",
        ".mjs",
        ".ts",
        ".cts",
        ".mts",
        ".md",
        ".yml",
        ".yaml",
        ".json",
        ".jsonc",
      ],
    },
  },

  "lsp": {
    "eslint": { "disabled": true },
    "biome": { "disabled": true },
    "oxlint": {
      "command": ["yarn", "oxlint", "--lsp"],
      "extensions": [
        ".js",
        ".cjs",
        ".mjs",
        ".ts",
        ".cts",
        ".mts",
        ".md",
        ".yml",
        ".yaml",
        ".json",
        ".jsonc",
      ],
    },
  },
}
