{
  "name": "locitree",
  "version": "0.0.1",
  "license": "MIT",
  "author": {
    "name": "Pavel Tereschenko",
    "email": "bigslycat@protonmail.com",
    "url": "https://github.com/bigslycat"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/cjs/index.d.cts",
  "typesVersions": {
    "*": {
      "node": [
        "dist/cjs/node/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node/index.d.ts",
        "default": "./dist/esm/node/index.js"
      },
      "require": {
        "types": "./dist/cjs/node/index.d.cts",
        "default": "./dist/cjs/node/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=10"
  },
  "packageManager": "yarn@6.0.0-rc.19"
}
