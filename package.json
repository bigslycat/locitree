{
  "name": "locitree",
  "version": "0.0.2",
  "license": "MIT",
  "author": {
    "name": "Pavel Tereschenko",
    "email": "bigslycat@protonmail.com",
    "url": "https://github.com/bigslycat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigslycat/locitree.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/cjs/index.d.cts",
  "typesVersions": {
    "*": {
      "node": [
        "dist/cjs/node/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node/index.d.ts",
        "default": "./dist/esm/node/index.js"
      },
      "require": {
        "types": "./dist/cjs/node/index.d.cts",
        "default": "./dist/cjs/node/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rslib build",
    "check": "yarn fmt:check && yarn lint && yarn typecheck && yarn test && yarn check:attw",
    "check:attw": "tsx tools/check-attw.ts",
    "fix": "yarn lint:fix && yarn fmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "yarn build",
    "test": "rstest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rslib/core": "^1.0.3",
    "@rstest/adapter-rslib": "^0.12.4",
    "@rstest/core": "^0.12.4",
    "@rstest/coverage-istanbul": "^0.12.4",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^14.18.0 || >=16.0.0"
  },
  "packageManager": "yarn@6.0.0-rc.23"
}
